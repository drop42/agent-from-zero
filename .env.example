# agent-from-zero 环境变量模板
#
# 用法：复制为 .env，填写你自己的值（.env 已被 .gitignore 排除，不会进仓库）
#   cp .env.example .env
# 加载方式（二选一）：
#   bash:   set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
# 注意：本程序不内置 .env 解析，必须由外部把变量注入到进程环境。

# ---------------------------------------------------------------- 模型（必需）

# 模型服务的 API Key。agent-from-zero 与 agent-bot 都必须有，缺失时直接退出。
API_KEY=

# 模型服务地址，兼容 OpenAI 接口格式。默认 https://api.deepseek.com
BASE_URL=

# 模型名。默认 deepseek-chat
MODEL=

# ---------------------------------------------------- 工作区与状态目录（强烈建议）

# Agent 只能在这个目录内读写文件、执行命令（第 3 课的硬规则）。
# 不设置时等于启动时的当前目录——如果在仓库里直接启动，Agent 就能改这个项目。
NAMI_WORKSPACE=

# 程序自己的状态目录：会话、定时任务、长期记忆、MCP 配置都放这里。
# 必须位于工作区之外，否则 Agent 可以改写自己的历史与配置。
# 默认 ~/.nami-agent
NAMI_STATE_DIR=

# ------------------------------------------------------ 上下文阈值（可选）

# 上一次请求的 prompt_tokens 超过这个值：清理旧的工具结果。默认 16000
NAMI_SOFT_LIMIT=

# 超过这个值：把早期对话摘要压缩。默认 24000
NAMI_HARD_LIMIT=

# ------------------------------------------------ Telegram 渠道（仅 agent-bot）

# BotFather 创建的机器人 token。等同于控制权：只放环境变量，不要提交、不要写进代码。
# 泄露后用 BotFather 的 /revoke 重新生成。
TG_BOT_TOKEN=

# 允许操作的 Telegram 用户 id，逗号分隔多个，例如 111111111,222222222。
# 为空时 agent-bot 直接拒绝启动；不在名单里的消息只记日志、不回复。
TG_ALLOWED_USERS=

# 聊天内确认的等待时间（秒），超时视为拒绝。默认 120
TG_CONFIRM_WAIT=

# 长轮询的超时（秒），决定定时任务的触发精度：轮询挂多久，任务最晚就晚多久触发。默认 10
TG_POLL_TIMEOUT=
